msgstr "Weitere Informationen"

#: templates/legal/privacy_policy.html:194
msgid "GitHub Sign-In (Social Login)"
msgstr "GitHub-Anmeldung (Social Login)"

#: templates/legal/privacy_policy.html:196
msgid ""
"\n"
